{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    // Consume checked SDK declarations, including when using the editor service.
    "disableSourceOfProjectReferenceRedirect": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@framework/*": ["src/renderer/WebSDK/Framework/src/*"],
      "@cubismsdksamples/*": ["src/renderer/WebSDK/src/*"],
      "@motionsyncframework/*": ["src/renderer/WebSDK/src/Framework/src/*"],
      "@motionsync/*": ["src/renderer/MotionSync/motionsync/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.d.ts"
  ],
  "references": [{ "path": "./tsconfig.sdk.json" }]
}
